# Supabase - SupabaseダッシュボードのProject Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Stripe（ポイント購入）────────────────────────────
# Stripeダッシュボード > 開発者 > APIキー から取得
# NEXT_PUBLIC_ は付けないこと（付けるとブラウザに配られてしまう）
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Stripeダッシュボード > 開発者 > Webhook で作成したエンドポイントの署名シークレット
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Supabase > Project Settings > API の service_role キー
# 決済完了の通知からポイントを付与するために必要。絶対に公開しないこと
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 本番のURL（決済後の戻り先に使う）
NEXT_PUBLIC_SITE_URL=https://my-teas.jp
